# Preserve the exact proof-source bytes recorded in the snapshot.
*.lean -text
*.md text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.json -text
*.txt -text
lean-toolchain text eol=lf
# Preserve the manuscript bundle's own byte manifest across platforms.
docs/paper/** -text
*.pdf binary
*.bin binary
*.zip binary
