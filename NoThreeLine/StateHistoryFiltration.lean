import NoThreeLine.GenericCreditMartingale

/-! The natural filtration generated by all states through discrete index k.
This observes state history; it does not silently include unused future noise. -/
set_option autoImplicit false
noncomputable section
open MeasureTheory ProbabilityTheory Set Function

namespace NoThreeLine.StateHistory

def history {S Ω : Type*} (X : ℕ → Ω → S) (k : ℕ) (ω : Ω) : Fin (k+1) → S := fun j => X j.val ω

theorem history_measurable {S Ω : Type*} [MeasurableSpace S] [MeasurableSpace Ω]
    (X : ℕ → Ω → S) (hX : ∀ k, Measurable (X k)) (k : ℕ) : Measurable (history X k) :=
  measurable_pi_lambda _ (fun j => hX j.val)

def filtration {S Ω : Type*} [MeasurableSpace S] [MeasurableSpace Ω]
    (X : ℕ → Ω → S) (hX : ∀ k, Measurable (X k)) : Filtration ℕ (inferInstance : MeasurableSpace Ω) where
  seq k := MeasurableSpace.comap (history X k) inferInstance
  mono' := by
    intro i j hij
    let take : (Fin (j+1) → S) → (Fin (i+1) → S) := fun v k => v (Fin.castLE (Nat.succ_le_succ hij) k)
    have hm : Measurable take := measurable_pi_lambda _ (fun k => measurable_pi_apply (Fin.castLE (Nat.succ_le_succ hij) k))
    have he : history X i = take ∘ history X j := rfl
    change MeasurableSpace.comap (history X i) inferInstance ≤ MeasurableSpace.comap (history X j) inferInstance
    rw [he,← MeasurableSpace.comap_comp]
    exact MeasurableSpace.comap_mono hm.comap_le
  le' k := (history_measurable X hX k).comap_le

theorem state_stronglyAdapted {S Ω : Type*} [MeasurableSpace S] [MeasurableSpace Ω]
    (X : ℕ → Ω → S) (hX : ∀ k, Measurable (X k)) (z : S → ℝ) (hz : Measurable z) :
    StronglyAdapted (filtration X hX) (fun k ω => z (X k ω)) := by
  intro k
  apply Measurable.stronglyMeasurable
  have hm : Measurable (fun a : Fin (k+1) → S => z (a (Fin.last k))) :=
    hz.comp (measurable_pi_apply (Fin.last k))
  exact hm.comp (comap_measurable (history X k))

end NoThreeLine.StateHistory

#print axioms NoThreeLine.StateHistory.state_stronglyAdapted
